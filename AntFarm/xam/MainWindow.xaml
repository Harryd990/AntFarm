<Window x:Class="AntFarm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AntFarm" Height="550" Width="929">
    <Window.Resources>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="110" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="Black" BorderThickness="2" Margin="5,5,5,0">
            <Canvas x:Name="MainCanvas" Background="White" />
        </Border>
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2" Margin="5,0,5,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="Black" BorderThickness="0,0,1,1">
                        <Button x:Name="createNdestroybut" Content="Create and destroy" VerticalAlignment="Center" Margin="6,0" FontSize="11" Style="{StaticResource LinkButton}" Click="createNdestroybut_Click"/>
                    </Border>
                    <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,0,1,1">
                        <Button Content="Settings" VerticalAlignment="Bottom" Margin="6,0,6,6" FontSize="11" Style="{StaticResource LinkButton}" Click="SettingsBut_click"/>
                    </Border>
                    <Border Grid.Row="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                        <Button Content="Dev tools" VerticalAlignment="Center" Margin="6,0" FontSize="11" Style="{StaticResource LinkButton}" Click="Dev_tools_But_Click"/>
                    </Border>
                </Grid>
                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#EEEEEE" BorderBrush="Black" BorderThickness="0,0,0,1">
                            <TextBlock Text="Actions" FontSize="10" FontWeight="Bold" Padding="4,1"/>
                        </Border>
                        
                        <!-- Reverted back to StackPanel as requested -->
                        <StackPanel x:Name="ActionsContainer" Grid.Row="1">

                            <!-- Create and Destroy options -->
                            <StackPanel x:Name="PanelCreateDestroy" Visibility="Collapsed">
                                <Button Content="Build Farm" Click="BuildFarm_Click" Background="White"/>
                                <Button Content="Build Food Store" Click="BuildFoodStore_Click" Background="White"/>
                                <Button Content="Dig" Click="Dig_Click" Background="White"/>
                                <Button Content="Remove Building" Click="RemoveBuilding_Click" Background="White"/>
                            </StackPanel>

                            <!-- Settings options -->
                            <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                                <Button Content="Ideal Population" Click="IdealPop_Click" Background="White"/>
                                <Button Content="New Game" Click="NewGame_Click" Background="White"/>
                                <Button Content="Save Game" Click="SaveGame_Click" Background="White"/>
                                <Button Content="Get Statistics" Click="GetStats_Click" Background="White"/>
                            </StackPanel>

                            <!-- Dev Tools options -->
                            <StackPanel x:Name="PanelDevTools" Visibility="Collapsed">
                                <Button Content="Spawn Entity" Click="SpawnEntity_Click" Background="White"/>
                                <Button Content="Remove Area" Click="RemoveArea_Click" Background="White"/>
                                <Button Content="Get Cell Details" Click="GetCellDetails_Click" Background="White"/>
                                <Button Content="Edit Entity Details" Click="EditEntity_Click" Background="White"/>
                            </StackPanel>

                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#EEEEEE" BorderBrush="Black" BorderThickness="0,0,0,1">
                            <TextBlock Text="Updates" FontSize="10" FontWeight="Bold" Padding="4,1"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="UpdatesText"
                                       Text="Simulation ready."
                                       VerticalAlignment="Top"
                                       Margin="6,2"
                                       FontSize="10"
                                       Foreground="#333333"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>


                <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <TextBlock Grid.Row="0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4">Speed</TextBlock>


                    <Slider Grid.Row="1" x:Name="SpeedSlider"
                            Width="80"
                            Minimum="0" Maximum="5"
                            TickFrequency="0.5"
                            IsSnapToTickEnabled="True"
                            SmallChange="0.5"
                            LargeChange="1"
                            TickPlacement="TopLeft"
                            ToolTip="Simulation speed multiplier"
                            HorizontalAlignment="Center"/>


                    <UniformGrid Grid.Row="2" Rows="1" Columns="6" Margin="0,6,0,0" HorizontalAlignment="Stretch">
                        <TextBlock Text="0" FontSize="9" HorizontalAlignment="Center"/>
                        <TextBlock Text="1" FontSize="9" HorizontalAlignment="Center"/>
                        <TextBlock Text="2" FontSize="9" HorizontalAlignment="Center"/>
                        <TextBlock Text="3" FontSize="9" HorizontalAlignment="Center"/>
                        <TextBlock Text="4" FontSize="9" HorizontalAlignment="Center"/>
                        <TextBlock Text="5" FontSize="9" HorizontalAlignment="Center"/>
                    </UniformGrid>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>